# ============================================================================
# DataPilotFlow Docker Environment Configuration
# ============================================================================
# This file contains all environment variables for Docker deployment.
# Variables are organized by functional area and aligned with backend/.env

# ============================================================================
# 🔑 API KEYS & AUTHENTICATION
# ============================================================================

# GROQ API Key (Required for Module 1)
GROQ_API_KEY=

# OpenAI API Key (Required for Module 5 - evaluation)
OPENAI_API_KEY=

# Comet ML API Key (Optional - for evaluation and LLMOps)
COMET_API_KEY=

# JWT Secret Key (for authentication)
JWT_SECRET_KEY=your_jwt_secret_key_here

# ============================================================================
# 🌐 API SERVER CONFIGURATION
# ============================================================================

# Docker-specific overrides
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8800

# WebSocket timeout configuration
WEBSOCKET_TIMEOUT=300

# ============================================================================
# 🗄️ MONGODB CONFIGURATION (External Port: 27020)
# ============================================================================

# Connection Settings
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=datapilotflow
MONGO_USER=datapilotflow
MONGO_PASS=datapilotflow123

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Collection Names (Only used ones)
MONGO_STATE_CHECKPOINT_COLLECTION=state_checkpoint
MONGO_STATE_WRITES_COLLECTION=state_writes
MONGO_RAG_UPLOADS_COLLECTION=rag_file_uploads
MONGO_RAG_FAILED_EVENTS_COLLECTION=rag_failed_events
MONGO_USERS_COLLECTION=users
MONGO_ROLES_COLLECTION=roles
MONGO_KNOWLEDGE_SOURCES_COLLECTION=knowledge_sources
MONGO_KNOWLEDGE_JOBS_COLLECTION=knowledge_jobs

# ============================================================================
# 🔍 WEAVIATE VECTOR STORE CONFIGURATION (External Ports: 8081, 50052)
# ============================================================================

# Store Type
VECTOR_STORE_TYPE=weaviate

# Connection Settings
WEAVIATE_HOST=weaviate
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_HTTP_SECURE=false
WEAVIATE_GRPC_SECURE=false
WEAVIATE_USERNAME=
WEAVIATE_PASSWORD=
WEAVIATE_CONNECTION_SCHEME=http

# Collection Settings
WEAVIATE_VECTOR_COLLECTION_NAME=DataPilotFlowCollection
WEAVIATE_BATCH_SIZE=100
WEAVIATE_VECTOR_STORE_INDEX_NAME=datapilotflow

# ============================================================================
# 🐰 RABBITMQ MESSAGE QUEUE CONFIGURATION (External Ports: 5675, 15675)
# ============================================================================

# Connection Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=datapilotflow
RABBITMQ_PASS=datapilotflow123
RABBITMQ_VHOST=/
RABBITMQ_MESSAGE_TTL=86400000
RABBITMQ_HEARTBEAT=300

# RAG File Upload Queue Configuration
RABBITMQ_RAG_FILE_UPLOAD_EXCHANGE=datapilotflow_rag_file_upload_exchange
RABBITMQ_RAG_FILE_UPLOAD_QUEUE=datapilotflow_rag_file_upload_queue
RABBITMQ_RAG_FILE_UPLOAD_ROUTING_KEY=datapilotflow_rag_file_upload_routing_key

# Dead Letter Queue Configuration
RABBITMQ_RAG_FILE_UPLOAD_DLQ_EXCHANGE=datapilotflow_rag_file_processing_dlq_exchange
RABBITMQ_RAG_FILE_UPLOAD_DLQ_QUEUE=datapilotflow_rag_file_processing_dlq

# Archive Queue Configuration
RABBITMQ_RAG_FILE_UPLOAD_ARCHIVE_EXCHANGE=datapilotflow_rag_file_archive_exchange
RABBITMQ_RAG_FILE_UPLOAD_ARCHIVE_QUEUE=datapilotflow_rag_file_archive_queue

# ============================================================================
# 🤖 RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ============================================================================

# Core RAG Settings
RAG_TOP_K=5
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_SIMILARITY_THRESHOLD=0.6

# Embedding Model Configuration
RAG_EMBEDDING_ENDPOINT=https://api.openai.com
RAG_EMBEDDING_MODEL_ID=text-embedding-3-large
RAG_EMBEDDING_MODEL_DIM=3072
RAG_EMBEDDING_API_KEY=

# Generative Model Configuration
RAG_GENERATIVE_MODEL_ID=llama-3.3-70b-versatile
RAG_GENERATIVE_MODEL_ENDPOINTS=http://localhost:1234
RAG_GENERATIVE_MODEL_API_KEY=

# ============================================================================
# 📊 OBSERVABILITY & MONITORING
# ============================================================================

# Comet ML Configuration
COMET_PROJECT=datapilotflow

# LangSmith Configuration
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datapilotflow

# ============================================================================
# 📁 FILE UPLOAD CONFIGURATION
# ============================================================================

# RAG File Upload Directories
RAG_FILE_UPLOAD_INBOUND_DIR=./upload/inbound
RAG_FILE_UPLOAD_ARCHIVE_DIR=./upload/archive
RAG_FILE_UPLOAD_FAILED_DIR=./upload/failed

# ============================================================================
# 📚 KNOWLEDGE BASE CONFIGURATION
# ============================================================================

KNOWLEDGE_METADATA_FILE_NAME=config/knowledge_metadata.json
{
  "python.defaultInterpreterPath": "${workspaceFolder}/datapilotflow-api/.venv/bin/python",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": false
  },
  "pylance.typeCheckingMode": "basic",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/datapilotflow-api/src",
    "${workspaceFolder}/datapilotflow-agents/src",
    "${workspaceFolder}/datapilotflow-domain/src",
    "${workspaceFolder}/datapilotflow-services/src",
    "${workspaceFolder}/datapilotflow-persistence/src",
    "${workspaceFolder}/datapilotflow-processors/src"
  ],
  "python.analysis.include": [
    "${workspaceFolder}/datapilotflow-api/src",
    "${workspaceFolder}/datapilotflow-agents/src",
    "${workspaceFolder}/datapilotflow-domain/src",
    "${workspaceFolder}/datapilotflow-services/src",
    "${workspaceFolder}/datapilotflow-persistence/src",
    "${workspaceFolder}/datapilotflow-processors/src"
  ],
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/.*"
  ],
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.logLevel": "Warning",
  "pyright.disableOrganizeImports": false
}

{
  "include": [
    "src",
    "tests",
    "run_rag_mcp_server.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*"
  ],
  "pythonVersion": "3.13",
  "pythonPlatform": "Darwin",
  "venvPath": ".",
  "venv": ".venv",
  "stubPath": ".venv/lib/python3.13/site-packages",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportGeneralTypeIssues": false,
  "reportArgumentType": false,
  "reportAttributeAccessIssue": false,
  "extraPaths": [
    "src",
    "../datapilotflow-domain/src",
    "../datapilotflow-infrastructure/src",
    "../datapilotflow-services/src",
    "../datapilotflow-assistant-agent/src",
    ".venv/lib/python3.13/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "pythonVersion": "3.13",
      "pythonPlatform": "Darwin",
      "extraPaths": [
        "src",
        "../datapilotflow-domain/src",
        "../datapilotflow-infrastructure/src",
        "../datapilotflow-services/src",
        "../datapilotflow-assistant-agent/src",
        ".venv/lib/python3.13/site-packages"
      ]
    }
  ]
}
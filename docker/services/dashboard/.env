# DataPilotFlow Dashboard — Docker image build
#
# Vite only embeds variables prefixed with VITE_ at build time, so these are
# baked into the image and can't change per-deployment. VITE_API_BASE_URL
# below is only a fallback for direct `npm run dev`/`vite build` usage — the
# published container image ignores it and instead reads API_BASE_URL from
# the environment at container *startup* (see docker-compose.yml and
# docker/services/dashboard/docker-entrypoint.sh), so the same image works
# whether it's reached at localhost or a remote host.

VITE_ENVIRONMENT=production

VITE_API_VERSION=v1
VITE_API_BASE_URL=http://localhost:8800

VITE_APP_NAME=dataPilotFlow
VITE_APP_VERSION=1.0.0

VITE_ENABLE_DEV_TOOLS=false

VITE_WS_RECONNECT_ATTEMPTS=3
VITE_WS_RECONNECT_DELAY=2000

VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

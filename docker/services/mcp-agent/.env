# DataPilotFlow RAG Agent MCP Server - Docker Service Configuration

# MCP Server Configuration
MCP_SERVER_NAME=datapilotflow-rag-expert
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=65510

# MongoDB Configuration
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=datapilotflow
MONGO_USER=datapilotflow
MONGO_PASS=datapilotflow123
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Vector Database (Milvus) Configuration
VECTOR_DB_HOST=milvus
VECTOR_DB_HTTP_PORT=19530
VECTOR_DB_USERNAME=root
VECTOR_DB_PASSWORD=Milvus
VECTOR_DB_CONNECTION_SCHEME=http

# Agent Tracing Configuration
AGENT_TRACING_ENABLED=false
AGENT_TRACING_API_KEY=
AGENT_TRACING_URL=http://localhost:5173/api
AGENT_TRACING_PROJECT_NAME=datapilotflow
AGENT_TRACING_DEFAULT_ENVIRONMENT=production

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

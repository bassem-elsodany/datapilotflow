# DataPilotFlow API Server - Docker Service Configuration

# API Server Configuration
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8800
API_VERSION=v1
WEBSOCKET_TIMEOUT=60

# MongoDB Configuration
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=datapilotflow
MONGO_USER=datapilotflow
MONGO_PASS=datapilotflow123
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_AGENT_STATE_CHECKPOINT_ENABLED=false
MONGO_AGENT_STATE_CHECKPOINT_DB_NAME=datapilotflow_agent
MONGO_AGENT_STATE_CHECKPOINT_COLLECTION=datapilotflow_agent_state_checkpoints
MONGO_AGENT_STATE_WRITES_COLLECTION=datapilotflow_agent_state_writes

# Vector Database (Milvus) Configuration
VECTOR_DB_HOST=milvus
VECTOR_DB_HTTP_PORT=19530
VECTOR_DB_USERNAME=root
VECTOR_DB_PASSWORD=Milvus
VECTOR_DB_CONNECTION_SCHEME=http

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=datapilotflow
RABBITMQ_PASS=datapilotflow123

# JWT Configuration
JWT_SECRET_KEY=your-production-secret-key-change-this

# RAG Configuration
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# Agent Tracing Configuration
AGENT_TRACING_ENABLED=false
AGENT_TRACING_API_KEY=
AGENT_TRACING_URL=http://localhost:5173/api
AGENT_TRACING_PROJECT_NAME=datapilotflow
AGENT_TRACING_DEFAULT_ENVIRONMENT=production

# File Management Directories
RAG_FILE_UPLOAD_INBOUND_DIR=./upload/inbound
RAG_FILE_UPLOAD_ARCHIVE_DIR=./upload/archive
RAG_FILE_UPLOAD_FAILED_DIR=./upload/failed
RAG_FILE_UPLOAD_OUTPUT_DIR=./upload/output
RAG_INGESTION_JOBS_OUTPUT_DATA_DIR=./ingestion_jobs_output_data

# Knowledge Base Configuration
KNOWLEDGE_METADATA_FILE_NAME=config/knowledge_metadata.json

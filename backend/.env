# ============================================================================
# DataPilotFlow Environment Configuration
# ============================================================================
# This file contains all environment variables used by the DataPilotFlow application.
# Variables are organized by functional area for easy maintenance.

# ============================================================================
# 🔑 API KEYS & AUTHENTICATION
# ============================================================================

# Comet ML API Key (Optional - for evaluation and LLMOps)
COMET_API_KEY=qm3y9SGc9HWuBA2XDnp6b3V1M

# JWT Secret Key (for authentication)
JWT_SECRET_KEY=supersecret
# ============================================================================
# 🌐 API SERVER CONFIGURATION
# ============================================================================

API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8800
WEBSOCKET_TIMEOUT=60

# ============================================================================
# 🗄️ MONGODB CONFIGURATION
# ============================================================================

# Connection Settings
MONGO_HOST=localhost
MONGO_PORT=27020
MONGO_DB_NAME=datapilotflow
MONGO_USER=datapilotflow
MONGO_PASS=datapilotflow123

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Collection Names
MONGO_AGENT_STATE_CHECKPOINT_DB_NAME=datapilotflow_agent
MONGO_AGENT_STATE_CHECKPOINT_COLLECTION=state_checkpoint
MONGO_AGENT_STATE_WRITES_COLLECTION=state_writes

# ============================================================================
# 🔍 VECTOR STORE CONFIGURATION
# ============================================================================
# Connection Settings
VECTOR_DB_HOST=localhost
VECTOR_DB_HTTP_PORT=19530
VECTOR_DB_USERNAME=root
VECTOR_DB_PASSWORD=Milvus
VECTOR_DB_CONNECTION_SCHEME=http # Options: http or https

# ============================================================================
# 🐰 RABBITMQ MESSAGE QUEUE CONFIGURATION
# ============================================================================

# Connection Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5675
RABBITMQ_USER=datapilotflow
RABBITMQ_PASS=datapilotflow123
RABBITMQ_VHOST=/
RABBITMQ_MESSAGE_TTL=86400000
RABBITMQ_HEARTBEAT=300

# ============================================================================
# 🤖 RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ============================================================================

# Core RAG Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# ============================================================================
# 📊 OBSERVABILITY & MONITORING
# ============================================================================

OBSERVABILITY_ENABLED=false
# Comet ML Configuration
COMET_PROJECT=datapilotflow

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=pr-minty-chop-32

# ============================================================================
# 📁 FILE UPLOAD CONFIGURATION
# ============================================================================

# RAG File Upload Directories
RAG_FILE_UPLOAD_INBOUND_DIR=./upload/inbound
RAG_FILE_UPLOAD_ARCHIVE_DIR=./upload/archive
RAG_FILE_UPLOAD_FAILED_DIR=./upload/failed
RAG_INGESTION_JOBS_OUTPUT_DATA_DIR=./ingestion_jobs_output_data

# ============================================================================
# 📚 KNOWLEDGE BASE CONFIGURATION
# ============================================================================

KNOWLEDGE_METADATA_FILE_NAME=config/knowledge_metadata.json

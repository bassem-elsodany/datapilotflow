# DataPilotFlow Dashboard — Docker image build
#
# Vite only embeds variables prefixed with VITE_ at build time.
# The browser runs on your machine and must reach the API via the host-mapped port
# (see docker-compose: api publishes 8800:8800), not the Docker service name "api".

VITE_ENVIRONMENT=production

# API — must match host port mapped for datapilotflow-api-server (8800)
VITE_API_VERSION=v1
VITE_API_BASE_URL=http://localhost:8800

VITE_APP_NAME=dataPilotFlow
VITE_APP_VERSION=1.0.0

VITE_ENABLE_DEV_TOOLS=false

VITE_WS_RECONNECT_ATTEMPTS=3
VITE_WS_RECONNECT_DELAY=2000

VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

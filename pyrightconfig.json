{
  "typeCheckingMode": "basic",
  "pythonVersion": "3.13",
  "pythonPlatform": "Darwin",
  "venvPath": ".",
  "include": [
    "datapilotflow-api/src",
    "datapilotflow-rag-agent/src",
    "datapilotflow-assistant-agent/src",
    "datapilotflow-domain/src",
    "datapilotflow-services/src",
    "datapilotflow-persistence/src",
    "datapilotflow-processors/src"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*"
  ],
  "extraPaths": [
    "${workspaceRoot}/datapilotflow-api/src",
    "${workspaceRoot}/datapilotflow-rag-agent/src",
    "${workspaceRoot}/datapilotflow-assistant-agent/src",
    "${workspaceRoot}/datapilotflow-domain/src",
    "${workspaceRoot}/datapilotflow-services/src",
    "${workspaceRoot}/datapilotflow-persistence/src",
    "${workspaceRoot}/datapilotflow-processors/src"
  ],
  "reportMissingImports": false,
  "reportMissingTypeStubs": false,
  "reportGeneralTypeIssues": true,
  "reportOptionalMemberAccess": false,
  "reportOptionalSubscript": false,
  "reportOptionalIterable": false,
  "reportOptionalArgumentType": false,
  "reportOptionalAssignment": false,
  "reportOptionalOperand": false,
  "reportOptionalCallOperand": false
}

# ============================================================================
# DataPilotFlow Events Service Environment Configuration
# ============================================================================
# This file contains environment variables for the events exposure layer.
# Copy this file to .env.local for local development configuration.

# ============================================================================
# 🔑 API KEYS & AUTHENTICATION
# ============================================================================
AGENT_TRACING_ENABLED=false
AGENT_TRACING_URL=http://10.0.10.36:3000
AGENT_TRACING_API_KEY=ROTATED_REDACTED_SECRET
AGENT_TRACING_DEFAULT_ENVIRONMENT=development
AGENT_TRACING_PROJECT_NAME=datapilotflow

# JWT Secret Key (for authentication)
JWT_SECRET_KEY=supersecret

# ============================================================================
# 🗄️ MONGODB CONFIGURATION
# ============================================================================
# Connection Settings
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=datapilotflow
MONGO_USER=datapilotflow
MONGO_PASS=datapilotflow123

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_CONNECT_TIMEOUT_MS=20000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ============================================================================
# 🐰 RABBITMQ MESSAGE QUEUE CONFIGURATION
# ============================================================================
# Connection Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=datapilotflow
RABBITMQ_PASS=datapilotflow123
RABBITMQ_VHOST=/
RABBITMQ_MESSAGE_TTL=86400000
RABBITMQ_HEARTBEAT=300

# ============================================================================
# 🔍 VECTOR STORE CONFIGURATION
# ============================================================================
# Connection Settings (needed for event processors)
VECTOR_DB_HOST=milvus
VECTOR_DB_HTTP_PORT=19530
VECTOR_DB_USERNAME=root
VECTOR_DB_PASSWORD=Milvus
VECTOR_DB_CONNECTION_SCHEME=http

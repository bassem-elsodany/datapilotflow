# DataPilotFlow Dashboard Environment Configuration

# Environment (development, staging, production)
ENVIRONMENT=development

# API Configuration
API_VERSION=v1
API_BASE_URL=http://localhost:8800

# Application Configuration
APP_NAME=dataPilotFlow
APP_VERSION=1.0.0

# Feature Flags
ENABLE_DEV_TOOLS=true

# WebSocket Configuration
WS_RECONNECT_ATTEMPTS=3
WS_RECONNECT_DELAY=2000

# Debug Configuration
DEBUG_MODE=true
LOG_LEVEL=debug
